---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign pages_to_include = site.html_pages | where_exp: "page", "page.url != '/404.html'" | where_exp: "page", "page.sitemap != false" %}
{% for page in pages_to_include %}
  {% if page.url contains '/admin' %}{% continue %}{% endif %}
  {%- comment -%}
    Only emit lastmod when the page carries a real date in its front matter.
    Falling back to site.time stamped every URL with the build time on every
    deploy, which makes Google ignore the field entirely.
  {%- endcomment -%}
  {% assign lastmod = page.last_modified_at | default: page.date %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    {% if lastmod %}<lastmod>{{ lastmod | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
{% endfor %}
{% for post in site.posts %}
  {% assign lastmod = post.last_modified_at | default: post.date %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ lastmod | date_to_xmlschema }}</lastmod>
  </url>
{% endfor %}
</urlset>
