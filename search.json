---
layout: null
permalink: /search.json
---
[
{% assign first = true %}
{% for post in site.posts %}
  {% unless first %},{% endunless %}
  {
    "type": "Article",
    "title": {{ post.title | jsonify }},
    "description": {{ post.description | default: '' | strip_html | strip_newlines | jsonify }},
    "category": {{ post.category | default: 'China Media Guide' | jsonify }},
    "date": {{ post.date | date: '%Y-%m-%d' | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "content": {{ post.content | strip_html | strip_newlines | replace: '  ', ' ' | jsonify }}
  }
  {% assign first = false %}
{% endfor %}
{% for item in site.pages %}
  {% if item.title and item.url != '/search/' and item.url != '/search.json' and item.url != '/404.html' and item.sitemap != false %}
    {% unless first %},{% endunless %}
    {
      "type": "Page",
      "title": {{ item.title | jsonify }},
      "description": {{ item.description | default: '' | strip_html | strip_newlines | jsonify }},
      "category": {{ item.search_category | default: 'PR Channel' | jsonify }},
      "date": "",
      "url": {{ item.url | relative_url | jsonify }},
      "content": {{ item.content | strip_html | strip_newlines | replace: '  ', ' ' | jsonify }}
    }
    {% assign first = false %}
  {% endif %}
{% endfor %}
]
