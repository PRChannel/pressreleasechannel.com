---
layout: null
permalink: /search.json
---
[
{% assign searchable = site.posts %}
{% for item in searchable %}
  {
    "title": {{ item.title | jsonify }},
    "description": {{ item.description | default: '' | jsonify }},
    "category": {{ item.category | default: 'China Media Guide' | jsonify }},
    "date": {{ item.date | date: '%Y-%m-%d' | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "content": {{ item.content | markdownify | strip_html | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
